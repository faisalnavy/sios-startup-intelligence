{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "env": {
    "NEXT_PUBLIC_API_URL": "@sios_api_url",
    "NEXT_PUBLIC_SUPABASE_URL": "@sios_supabase_url",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "@sios_supabase_anon_key",
    "NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY": "@sios_stripe_pk"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" }
      ]
    }
  ]
}
